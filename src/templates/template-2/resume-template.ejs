<!DOCTYPE html>
<html>
<head><meta charset="utf-8"><style><%- styles %></style></head>
<body>
  <%- include('partials/header.ejs', { name, location, phone, email, linkedin, portfolio, github, npm, targeting }) %>
  <div class="headline"><%= headline %></div>
  <div class="section-title">Summary</div><div class="summary"><%= summary %></div>
  <div class="section-title">Experience</div>
  <% experience.forEach(function(job) { %>
    <div class="job">
      <div class="job-header">
        <div class="job-heading"><span class="job-title"><%= job.title %></span><span class="job-company"> <%= job.company %></span></div>
        <div class="job-meta"><span><%= job.location %></span><span><%= job.date %></span></div>
      </div>
      <% if (job.stack?.length) { %><div class="job-stack"><span class="job-stack-label">Stack:</span> <%= job.stack.join(', ') %></div><% } %>
      <ul class="bullets"><% job.bullets.forEach(function(b) { %><li><%- b %></li><% }); %></ul>
    </div>
  <% }); %>
  <% if (npmPackages && npmPackages.length > 0) { %><div class="section-title">Open Source</div><% npmPackages.forEach(function(pkg) { var parts = pkg.split(' - '); %><div class="os-item"><span class="os-name"><%= parts[0] %></span><% if (parts.length > 1) { %> — <span class="os-tag">npm package</span><div class="os-desc"><%= parts.slice(1).join(' - ') %></div><% } %></div><% }); %><% } %>
  <div class="section-title">Skills</div><table class="skills-table"><% for (var i = 0; i < skills.length; i += 2) { %><tr><td><span class="skill-cat"><%= skills[i].category %>: </span><span class="items"><%= skills[i].items.map(function(item) { return item.name; }).join(', ') %></span></td><td><% if (skills[i + 1]) { %><span class="skill-cat"><%= skills[i + 1].category %>: </span><span class="items"><%= skills[i + 1].items.map(function(item) { return item.name; }).join(', ') %></span><% } %></td></tr><% } %></table>
  <div class="section-title">Education</div><% education.forEach(function(edu) { %><div class="edu-row"><div class="edu-degree"><%= edu.degree %><%= edu.fieldOfStudy ? ', ' + edu.fieldOfStudy : '' %> — <%= edu.institution %></div><div class="edu-meta"><%= edu.startDate %><%= edu.endDate ? ' – ' + edu.endDate : '' %></div></div><% }); %>
</body></html>

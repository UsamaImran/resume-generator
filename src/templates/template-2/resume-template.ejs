<!DOCTYPE html>
<html>
<head><meta charset="utf-8"><style><%- styles %></style></head>
<body>
  <%- include('partials/header.ejs', { name, headline, location, phone, email, linkedin, portfolio, github, npm, targeting }) %>
  <div class="section-title">Summary</div><div class="summary"><%= summary %></div>
  <div class="section-title">Experience</div>
  <% experience.forEach(function(job) { %>
    <div class="job">
      <div class="job-header">
        <div class="job-heading"><span class="job-title"><%= job.title %></span><span class="job-company"> <%= job.company %></span></div>
        <div class="job-meta"><span><%= job.location %></span><span><%= job.date %></span></div>
      </div>
      <% if (job.stack?.length) { %><div class="job-stack"><span class="job-stack-label">Stack:</span> <%= job.stack.join(', ') %></div><% } %>
      <ul class="bullets"><% job.bullets.forEach(function(b) { %><li><%- b %></li><% }); %></ul>
    </div>
  <% }); %>
  <% if (projects && projects.length > 0) { %>
    <div class="section-title">Selected Projects</div>
    <% projects.forEach(function(project) { %>
      <div class="project">
        <div class="project-header">
          <div class="project-title-wrap">
            <span class="project-name"><%= project.name %></span>
            <% if (project.liveUrl) { %><a class="project-live-link" href="<%= project.liveUrl %>" aria-label="Open <%= project.name %> live site" title="Live site" target="_blank" rel="noopener noreferrer">↗</a><% } %>
          </div>
          <% if (project.repoUrl) { %>
            <a class="project-repo-link" href="<%= project.repoUrl %>" target="_blank" rel="noopener noreferrer" aria-label="Open <%= project.name %> repository" title="GitHub repository">
              <svg class="github-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .5C5.65.5.5 5.78.5 12.29c0 5.22 3.29 9.65 7.86 11.21.58.11.79-.26.79-.57v-2.02c-3.2.71-3.88-1.39-3.88-1.39-.53-1.37-1.28-1.74-1.28-1.74-1.04-.73.08-.72.08-.72 1.15.08 1.76 1.22 1.76 1.22 1.02 1.79 2.68 1.27 3.33.97.1-.76.4-1.27.73-1.56-2.55-.3-5.24-1.3-5.24-5.8 0-1.28.45-2.32 1.18-3.14-.12-.3-.51-1.49.11-3.1 0 0 .97-.32 3.17 1.2a10.62 10.62 0 0 1 5.77 0c2.2-1.52 3.17-1.2 3.17-1.2.62 1.61.23 2.8.11 3.1.73.82 1.18 1.86 1.18 3.14 0 4.51-2.69 5.49-5.25 5.79.41.36.78 1.08.78 2.18v3.23c0 .31.21.69.8.57A11.81 11.81 0 0 0 23.5 12.29C23.5 5.78 18.35.5 12 .5Z"/></svg>
              <span>Repository</span>
            </a>
          <% } %>
        </div>
        <% if (project.stack?.length) { %><div class="project-stack"><span class="project-stack-label">Stack:</span> <%= project.stack.join(', ') %></div><% } %>
        <ul class="bullets"><% project.bullets.forEach(function(b) { %><li><%- b %></li><% }); %></ul>
      </div>
    <% }); %>
  <% } %>
  <% if (npmPackages && npmPackages.length > 0) { %><div class="section-title">Open Source</div><% npmPackages.forEach(function(pkg) { var parts = pkg.split(' - '); %><div class="os-item"><span class="os-name"><%= parts[0] %></span><% if (parts.length > 1) { %> — <span class="os-tag">npm package</span><div class="os-desc"><%= parts.slice(1).join(' - ') %></div><% } %></div><% }); %><% } %>
  <div class="section-title">Skills</div>
  <div class="skills-list">
    <% skills.forEach(function(skill) { %>
      <div class="skill-item"><span class="skill-cat"><%= skill.category %>: </span><span class="items"><%= skill.items.map(function(item) { return item.name; }).join(', ') %></span></div>
    <% }); %>
  </div>
  <div class="section-title">Education</div><% education.forEach(function(edu) { %><div class="edu-row"><div class="edu-degree"><%= edu.degree %><%= edu.fieldOfStudy ? ', ' + edu.fieldOfStudy : '' %> — <%= edu.institution %></div><div class="edu-meta"><%= edu.startDate %><%= edu.endDate ? ' – ' + edu.endDate : '' %></div></div><% }); %>
</body></html>

<!DOCTYPE html>
<html>
<head><meta charset="utf-8"><style><%- styles %></style></head>
<body>
  <%- include('partials/header.ejs', { name, location, phone, email, linkedin, portfolio, github, npm, targeting }) %>
  <div class="section-title">Re: Application for <%= job_title %> at <%= company_name %></div>
  <div class="recipient"><div class="recipient-name"><%= recipient_name %></div><div><%= company_name %></div><% if (company_address) { %><div><%= company_address %></div><% } %><div class="date"><%= new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></div></div>
  <div class="body"><% paragraphs.forEach(function(p) { %><% if (p.title && p.title.trim() !== '') { %><h3 class="paragraph-title"><%= p.title %></h3><% } %><p><%= p.text %></p><% }); %></div>
  <div class="closing"><p>Sincerely,</p><div class="signature"><%= name %></div></div>
</body></html>

<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <style><%- styles %></style>
</head>
<body>
  <%- include('partials/header.ejs', { name, location, phone, email, linkedin, portfolio, github, npm, targeting }) %>
  <div class="headline"><strong><%= headline %></strong></div>
  <div class="summary"><%= summary %></div>
  <h2>Technical Skills</h2>
  <% skills.forEach(function(cat) { %>
    <div class="skill-block"><div class="skill-category-line"><span class="skill-category-label"><%= cat.category %>:</span><span class="skill-list"><% var skillTexts = cat.items.map(function(item) { return item.highlight ? '<span class="skill-item"><strong>' + item.name + '</strong></span>' : '<span class="skill-item">' + item.name + '</span>'; }); %><%- skillTexts.join('') %></span></div></div>
  <% }); %>
  <h2>Work Experience</h2>
  <% experience.forEach(function(job) { %>
    <div class="job">
      <div class="job-header"><span class="job-title-company"><%= job.title %> </span><span class="job-title-company"> <%= job.company %></span></div>
      <div class="job-header"><div class="job-date"><%= job.date %></div><div class="job-date"><%= job.location %></div></div>
      <% if (job.stack?.length) { %><div class="job-stack"><strong>Stack:</strong> <%= job.stack.join(', ') %></div><% } %>
      <ul><% job.bullets.forEach(function(b) { %><li><%- b %></li><% }); %></ul>
    </div>
  <% }); %>
  <% if (projects && projects.length > 0) { %>
    <h2>Selected Projects</h2>
    <% projects.forEach(function(project) { %>
      <div class="project">
        <div class="project-header"><span class="project-name"><%= project.name %></span></div>
        <% if (project.stack?.length) { %><div class="project-stack"><strong>Stack:</strong> <%= project.stack.join(', ') %></div><% } %>
        <ul><% project.bullets.forEach(function(b) { %><li><%- b %></li><% }); %></ul>
      </div>
    <% }); %>
  <% } %>
  <% if (npmPackages && npmPackages.length > 0) { %><h2>Open Source</h2><ul class="open-source-list"><% npmPackages.forEach(function(pkg) { var parts = pkg.split(' - '); %><li><strong><%= parts[0] %></strong> : <%= parts.slice(1).join(' - ') %></li><% }); %></ul><% } %>
  <h2>Education</h2>
  <div class="education"><% education.forEach(function(edu) { %><div class="education-item"><div class="education-left"><div class="education-degree"><%= edu.degree %><%= edu.fieldOfStudy ? ` in ${edu.fieldOfStudy}` : '' %>,</div><div class="education-date"><% if (edu.startDate || edu.endDate) { %><%= edu.startDate %><%= edu.endDate ? ` - ${edu.endDate}` : '' %><% } %></div></div><div class="education-right"><div class="education-institution"><%= edu.institution %></div><div class="education-gpa"><% if (edu.gpa) { %>GPA: <%= edu.gpa %><% } %></div></div></div><% }); %></div>
</body>
</html>
